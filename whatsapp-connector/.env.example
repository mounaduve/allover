# Öffentliche HTTPS-Adresse, unter der der Synology-Reverse-Proxy den Connector erreichbar macht
PUBLIC_BASE_URL=https://whatsapp.<dein-name>.synology.me
# Passwort, das du beim Verbinden in Claude und auf der Einrichtungsseite eingibst
CONNECTOR_PASSWORD=changeme-langes-passwort
# Beliebige lange Zufallsstrings, z.B. mit: openssl rand -hex 32
SESSION_SECRET=changeme-random-string
BRIDGE_TOKEN=changeme-random-string
